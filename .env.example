HOST=0.0.0.0
PORT=3002
LIGHTPOOL_RPC_URL=http://127.0.0.1:26300
LIGHTPOOL_WS_URL=ws://127.0.0.1:26400
ENABLE_INDEXER=true
# Sqlite persistence (blocks/checkpoints/bars/order history). false or DISABLE_PERSIST=true / --no-persist
ENABLE_SQLITE=true
# DISABLE_PERSIST=false
# Background writers for the unified PersistOp queue (default 4)
# PERSIST_WORKERS=4
SQLITE_PATH=data/clob-index.sqlite3
# Persist sqlite checkpoint after this many applied receipt blocks (default 1000)
CHECKPOINT_EVERY_BLOCKS=1000
