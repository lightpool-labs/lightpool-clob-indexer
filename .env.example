HOST=0.0.0.0
PORT=3002
LIGHTPOOL_RPC_URL=http://127.0.0.1:26300
LIGHTPOOL_WS_URL=ws://127.0.0.1:26400
ENABLE_INDEXER=true
# Sqlite persistence (history by default). false or DISABLE_PERSIST=true / --no-persist
ENABLE_SQLITE=true
# DISABLE_PERSIST=false
SQLITE_PATH=data/clob-index.sqlite3
# Receipt-block sqlite writes. Off by default; --persist-blocks or PERSIST_BLOCKS=true
# RocksDB index-state writes + epoch clones (ckpt--N). Off by default.
# --persist-checkpoint or PERSIST_CHECKPOINT=true
# Epoch length when enabled (default 1000 → clone at 999, 1999, …)
CHECKPOINT_EVERY_BLOCKS=1000
